<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:scrollbars="none">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingBottom="28dp">
        <TextView style="@style/Text.App.Headline" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingStart="@dimen/pad_screen" android:paddingTop="20dp" android:paddingBottom="4dp" android:text="@string/settings_title"/>
        <TextView style="@style/GroupLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/group_mode"/>
        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="@dimen/pad_screen" android:layout_marginEnd="@dimen/pad_screen">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                <LinearLayout android:id="@+id/row_run_mode" style="@style/TapRow" android:minHeight="64dp">
                    <LinearLayout style="@style/SwitchTextCol">
                        <TextView style="@style/RowTitle" android:text="@string/settings_run_mode" />
                        <TextView android:id="@+id/text_run_mode" style="@style/Text.App.Caption" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" />
                    </LinearLayout>
                    <ImageView style="@style/Chevron" android:src="@drawable/ic_chevron_right" android:importantForAccessibility="no" />
                </LinearLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginHorizontal="16dp" android:background="@color/outline" />
                <LinearLayout android:id="@+id/row_device_advice" style="@style/TapRow" android:minHeight="56dp">
                    <TextView style="@style/RowTitle" android:layout_width="0dp" android:layout_weight="1" android:text="@string/settings_device_advice" />
                    <ImageView style="@style/Chevron" android:src="@drawable/ic_chevron_right" android:importantForAccessibility="no" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <TextView style="@style/GroupLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/group_inference"/>
        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="@dimen/pad_screen" android:layout_marginEnd="@dimen/pad_screen">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                <LinearLayout style="@style/TapRow" android:clickable="false" android:focusable="false">
                    <LinearLayout style="@style/SwitchTextCol">
                        <TextView style="@style/RowTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/sw_keep_screen"/>
                        <TextView style="@style/Text.App.Caption" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/sw_keep_screen_sub"/>
                    </LinearLayout>
                    <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/sw_keep_screen" style="@style/RowSwitch" android:contentDescription="@string/sw_keep_screen"/>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="@dimen/pad_screen" android:layout_marginEnd="@dimen/pad_screen" android:layout_marginTop="10dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                <LinearLayout android:id="@+id/row_advanced" style="@style/TapRow" android:minHeight="56dp">
                    <LinearLayout style="@style/SwitchTextCol">
                        <TextView style="@style/RowTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/advanced_title"/>
                        <TextView style="@style/Text.App.Caption" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/advanced_sub"/>
                    </LinearLayout>
                    <ImageView style="@style/Chevron" android:src="@drawable/ic_chevron_right" android:importantForAccessibility="no"/>
                </LinearLayout>
                <LinearLayout android:id="@+id/advanced_content" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
                    <LinearLayout android:id="@+id/row_context_length" style="@style/TapRow" android:minHeight="56dp">
                        <LinearLayout style="@style/SwitchTextCol">
                            <TextView style="@style/RowTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/row_context_length"/>
                            <TextView android:id="@+id/text_context_length" style="@style/Text.App.Caption" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp"/>
                        </LinearLayout>
                        <ImageView style="@style/Chevron" android:src="@drawable/ic_chevron_right" android:importantForAccessibility="no"/>
                    </LinearLayout>
                    <LinearLayout android:id="@+id/row_gpu_layers" style="@style/TapRow" android:minHeight="56dp">
                        <LinearLayout style="@style/SwitchTextCol">
                            <TextView style="@style/RowTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/row_gpu_layers"/>
                            <TextView android:id="@+id/text_gpu_layers" style="@style/Text.App.Caption" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp"/>
                        </LinearLayout>
                        <ImageView style="@style/Chevron" android:src="@drawable/ic_chevron_right" android:importantForAccessibility="no"/>
                    </LinearLayout>
                    <LinearLayout android:id="@+id/row_diagnostics" style="@style/TapRow" android:minHeight="56dp">
                        <LinearLayout style="@style/SwitchTextCol">
                            <TextView style="@style/RowTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/action_diagnostics"/>
                        </LinearLayout>
                        <ImageView style="@style/Chevron" android:src="@drawable/ic_chevron_right" android:importantForAccessibility="no"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <TextView style="@style/GroupLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/group_storage"/>
        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="@dimen/pad_screen" android:layout_marginEnd="@dimen/pad_screen">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                <LinearLayout android:id="@+id/row_clear_cache" style="@style/TapRow" android:minHeight="56dp">
                    <LinearLayout style="@style/SwitchTextCol">
                        <TextView style="@style/RowTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/row_clear_cache"/>
                        <TextView android:id="@+id/text_cache_size" style="@style/Text.App.Caption" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp"/>
                    </LinearLayout>
                    <ImageView style="@style/Chevron" android:src="@drawable/ic_chevron_right" android:importantForAccessibility="no"/>
                </LinearLayout>
                <LinearLayout android:id="@+id/row_clear_sessions" style="@style/TapRow" android:minHeight="56dp">
                    <LinearLayout style="@style/SwitchTextCol">
                        <TextView style="@style/RowTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/row_clear_sessions"/>
                    </LinearLayout>
                    <ImageView style="@style/Chevron" android:src="@drawable/ic_chevron_right" android:importantForAccessibility="no"/>
                </LinearLayout>
                <LinearLayout android:id="@+id/row_privacy" style="@style/TapRow" android:minHeight="56dp">
                    <LinearLayout style="@style/SwitchTextCol">
                        <TextView style="@style/RowTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/privacy_title"/>
                    </LinearLayout>
                    <ImageView style="@style/Chevron" android:src="@drawable/ic_chevron_right" android:importantForAccessibility="no"/>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <TextView style="@style/GroupLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/group_about"/>
        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="@dimen/pad_screen" android:layout_marginEnd="@dimen/pad_screen">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                <LinearLayout android:id="@+id/row_license" style="@style/TapRow" android:minHeight="56dp">
                    <LinearLayout style="@style/SwitchTextCol">
                        <TextView style="@style/RowTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/row_license"/>
                    </LinearLayout>
                    <ImageView style="@style/Chevron" android:src="@drawable/ic_chevron_right" android:importantForAccessibility="no"/>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <TextView android:id="@+id/text_version" style="@style/Text.App.Caption" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:paddingTop="24dp"/>
    </LinearLayout>
</ScrollView>
