<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- 顶栏：当前模型 + 状态 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/pad_screen"
        android:paddingEnd="10dp"
        android:paddingTop="12dp">

        <View
            android:id="@+id/status_dot"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="@drawable/bg_dot" />

        <TextView
            android:id="@+id/text_model"
            style="@style/Text.App.ItemTitle"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:minHeight="48dp"
            android:gravity="center_vertical"
            android:background="?attr/selectableItemBackground"
            android:maxLines="1"
            android:breakStrategy="balanced"
            android:ellipsize="end" />

        <ImageButton
            android:id="@+id/btn_new"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_add"
            app:tint="@color/text_secondary"
            android:contentDescription="@string/action_new_conversation" />

        <ImageButton
            android:id="@+id/btn_history"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_history"
            app:tint="@color/text_secondary"
            android:contentDescription="@string/history_title" />

        <ImageButton
            android:id="@+id/btn_switch"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_tune"
            app:tint="@color/text_secondary"
            android:contentDescription="@string/action_more" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/pad_screen"
        android:paddingEnd="10dp">

        <TextView
            android:id="@+id/text_model_state"
            style="@style/Text.App.BodySec"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:paddingBottom="10dp"
            android:accessibilityLiveRegion="polite" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_unload_model"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/chat_unload_model" />
    </LinearLayout>

    <!-- 消息区 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/messages"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="8dp" />

        <ScrollView android:id="@+id/empty_wrap" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:scrollbars="none">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center" android:padding="32dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="12dp" android:paddingEnd="12dp">
                    <TextView style="@style/Text.App.Headline" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/chat_empty_title" />
                    <TextView android:id="@+id/empty_subtitle" style="@style/Text.App.BodySec" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="@string/chat_empty_sub" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/prompt_think" style="@style/Widget.App.Button.Outline" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="60dp" android:layout_marginTop="28dp" android:gravity="start|center_vertical" android:text="@string/chat_prompt_think" android:textColor="@color/text_secondary" app:strokeColor="@color/outline" app:icon="@drawable/ic_chat" app:iconTint="@color/text_secondary" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/prompt_write" style="@style/Widget.App.Button.Outline" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="60dp" android:gravity="start|center_vertical" android:text="@string/chat_prompt_write" android:textColor="@color/text_secondary" app:strokeColor="@color/outline" app:icon="@drawable/ic_copy" app:iconTint="@color/text_secondary" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/btn_get_model" style="@style/Widget.App.Button" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="60dp" android:layout_marginTop="24dp" android:text="@string/action_goto_market" android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_latest_message"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="8dp"
            android:minHeight="48dp"
            android:text="@string/chat_latest_message"
            android:visibility="gone" />
    </FrameLayout>

    <!-- 输入栏 -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="18dp"
        android:layout_marginEnd="18dp"
        android:layout_marginBottom="10dp"
        android:layout_marginTop="4dp"
        app:cardCornerRadius="18dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="bottom"
            android:paddingStart="18dp"
            android:paddingEnd="6dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp">

            <EditText
                android:id="@+id/input"
                style="@style/Text.App.Body"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:minHeight="46dp"
                android:maxLines="4"
                android:background="@null"
                android:hint="@string/chat_input_hint"
                android:textColorHint="@color/text_tertiary"
                android:inputType="textMultiLine|textCapSentences"
                android:imeOptions="actionNone"
                android:importantForAutofill="no" />

            <FrameLayout
                android:layout_width="48dp"
                android:layout_height="48dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_send"
                    style="@style/Widget.Material3.Button.IconButton.Filled"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="center"
                    app:icon="@drawable/ic_send"
                    app:iconTint="@color/md_on_primary"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    android:insetLeft="0dp"
                    android:insetRight="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:contentDescription="@string/action_send" />
            </FrameLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</LinearLayout>
