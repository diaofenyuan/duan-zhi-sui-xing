<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <TextView style="@style/Text.App.Headline" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingStart="@dimen/pad_screen" android:paddingEnd="@dimen/pad_screen" android:paddingTop="20dp" android:paddingBottom="20dp" android:text="@string/tab_market" />

    <!-- 搜索框 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginStart="@dimen/pad_screen"
        android:layout_marginEnd="@dimen/pad_screen"
        android:background="@drawable/bg_pill_outline">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="14dp"
            android:paddingEnd="14dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_search"
                app:tint="@color/text_tertiary" />

            <EditText
                android:id="@+id/input_search"
                style="@style/Text.App.Body"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="match_parent"
                android:layout_marginStart="10dp"
                android:background="@null"
                android:hint="@string/market_search_hint"
                android:textColorHint="@color/text_tertiary"
                android:maxLines="1"
                android:inputType="text"
                android:imeOptions="actionSearch"
                android:importantForAutofill="no" />
            <ImageButton android:id="@+id/btn_filters" android:layout_width="48dp" android:layout_height="48dp" android:background="?attr/selectableItemBackgroundBorderless" android:src="@drawable/ic_tune" app:tint="@color/text_secondary" android:contentDescription="@string/action_filters" />
        </LinearLayout>
    </FrameLayout>

    <!-- 筛选条件（任务 / 语言 / 参数量） -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:paddingTop="@dimen/gap_sm">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/pad_screen"
            android:paddingEnd="@dimen/pad_screen">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chip_task"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:singleSelection="true"
                app:selectionRequired="true"
                app:singleLine="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_task_all"
                    style="@style/Widget.App.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="@string/filter_all" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_task_text"
                    style="@style/Widget.App.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/filter_task_text" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_task_code"
                    style="@style/Widget.App.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/filter_task_code" />
            </com.google.android.material.chip.ChipGroup>

            <LinearLayout android:id="@+id/filters_advanced" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chip_lang"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                app:singleSelection="true"
                app:selectionRequired="true"
                app:singleLine="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_lang_all"
                    style="@style/Widget.App.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="@string/filter_lang_all" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_lang_zh"
                    style="@style/Widget.App.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/filter_lang_zh" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_lang_en"
                    style="@style/Widget.App.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/filter_lang_en" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_lang_multi"
                    style="@style/Widget.App.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/filter_lang_multi" />
            </com.google.android.material.chip.ChipGroup>

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chip_size"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                app:singleSelection="true"
                app:selectionRequired="true"
                app:singleLine="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_size_all"
                    style="@style/Widget.App.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="@string/filter_size_all" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_size_le2"
                    style="@style/Widget.App.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/filter_size_le2" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_size_mid"
                    style="@style/Widget.App.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/filter_size_mid" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_size_gt8"
                    style="@style/Widget.App.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/filter_size_gt8" />
            </com.google.android.material.chip.ChipGroup>
            </LinearLayout>
        </LinearLayout>
    </HorizontalScrollView>

    <!-- 本周精选横幅 -->
    <com.google.android.material.card.MaterialCardView android:id="@+id/card_hero" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="@dimen/pad_screen" android:layout_marginEnd="@dimen/pad_screen" android:layout_marginTop="12dp" android:clickable="true" android:focusable="true" app:cardBackgroundColor="@color/surface_variant" app:strokeWidth="0dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:padding="16dp">
            <ImageView android:layout_width="28dp" android:layout_height="28dp" android:src="@drawable/ic_sparkle" app:tint="@color/md_primary" android:importantForAccessibility="no" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="14dp">
                <TextView style="@style/Text.App.Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/hero_tag" />
                <TextView android:id="@+id/hero_title" style="@style/Text.App.Section" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" />
                <TextView android:id="@+id/hero_desc" style="@style/Text.App.Caption" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" />
            </LinearLayout>
            <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_chevron_right" app:tint="@color/text_secondary" android:importantForAccessibility="no" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- 推荐模型标题行 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/pad_screen"
        android:paddingEnd="@dimen/pad_screen"
        android:paddingTop="@dimen/gap_lg"
        android:paddingBottom="@dimen/gap_sm">

        <TextView
            style="@style/Text.App.Section"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="@string/section_recommended" />

        <TextView
            android:id="@+id/text_count"
            style="@style/Text.App.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ProgressBar
            android:id="@+id/progress"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="center" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="24dp"
            android:overScrollMode="never" />

        <com.example.localai.common.widget.EmptyStateView
            android:id="@+id/empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            app:esIcon="@drawable/ic_search"
            app:esTitle="@string/empty_market_title"
            app:esSubtitle="@string/empty_market_sub"
            app:esAction="@string/action_clear_filters" />
    </FrameLayout>

</LinearLayout>
