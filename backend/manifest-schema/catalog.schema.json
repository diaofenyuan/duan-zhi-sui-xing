{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.com/schemas/catalog.schema.json",
  "title": "Catalog",
  "description": "模型目录。目录本身仅供参考索引：客户端只展示 Manifest 签名验证通过的模型。签名由 catalog.sig 侧车文件承载，签名载荷为 catalog.json 的原始字节流。",
  "type": "object",
  "additionalProperties": true,
  "required": ["schemaVersion", "generatedAt", "models"],
  "properties": {
    "schemaVersion": { "type": "integer", "minimum": 1 },
    "generatedAt": { "type": "string", "minLength": 1 },
    "models": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["modelId", "version", "displayName"],
        "properties": {
          "modelId": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "minLength": 1 },
          "displayName": { "type": "string", "minLength": 1 },
          "description": { "type": "string" }
        }
      }
    }
  }
}
